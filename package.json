{
  "name": "agentic-video-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:backend": "pnpm --filter @agentic-video-editor/desktop-backend dev",
    "dev:frontend": "pnpm --filter @agentic-video-editor/desktop-frontend dev",
    "dev": "concurrently -k -n backend,frontend \"pnpm dev:backend\" \"pnpm dev:frontend\""
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "concurrently": "^9.0.0"
  }
}
