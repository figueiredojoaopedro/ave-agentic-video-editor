{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Video Editor",
  "version": "0.1.0",
  "identifier": "com.agenticvideoeditor.desktop",
  "build": {
    "beforeDevCommand": "concurrently -k \"pnpm --filter @agentic-video-editor/desktop-backend dev\" \"pnpm --filter @agentic-video-editor/desktop-frontend dev\"",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @agentic-video-editor/desktop-frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agentic Video Editor",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
